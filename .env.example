# ─── Database ────────────────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=adisker_db
DB_USER=adisker
DB_PASSWORD=change_me_in_production

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Минимум 256 бит (32 символа). Сгенерировать: openssl rand -base64 64
JWT_SECRET=change_me_in_production_at_least_256_bits_long_secret_key_here

# ─── App ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
INVITE_URL=http://localhost:3000/invite

# ─── Storage ─────────────────────────────────────────────────────────────────
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=/var/adisker/uploads

# S3 (только если STORAGE_TYPE=s3)
#S3_BUCKET=adisker-files
#S3_REGION=us-east-1
#S3_ENDPOINT=
#S3_ACCESS_KEY=
#S3_SECRET_KEY=

# ─── Mail (опционально) ───────────────────────────────────────────────────────
#MAIL_HOST=smtp.gmail.com
#MAIL_PORT=587
#MAIL_USER=
#MAIL_PASS=

# ─── AI (опционально) ─────────────────────────────────────────────────────────
#GEMINI_API_KEY=

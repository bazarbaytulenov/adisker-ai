# ─── Database (AWS RDS PostgreSQL) ───────────────────────────────────────────
DB_HOST=your-rds-instance.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=adisker_db
DB_USER=adisker
DB_PASSWORD=change_me_strong_password

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Сгенерировать: openssl rand -base64 64
JWT_SECRET=change_me_at_least_256_bits_long_secret_key_here

# ─── App URLs ─────────────────────────────────────────────────────────────────
FRONTEND_URL=https://your-domain.com
INVITE_URL=https://your-domain.com/invite

# ─── Storage ─────────────────────────────────────────────────────────────────
# Для EC2 локальное хранилище:
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=/var/adisker/uploads

# Для S3 (рекомендуется для продакшена):
# STORAGE_TYPE=s3
# S3_BUCKET=adisker-files
# S3_REGION=us-east-1
# S3_ENDPOINT=
# S3_ACCESS_KEY=your_access_key
# S3_SECRET_KEY=your_secret_key

# ─── Mail (опционально) ───────────────────────────────────────────────────────
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USER=your@gmail.com
# MAIL_PASS=your_app_password

# ─── AI (опционально) ─────────────────────────────────────────────────────────
# GEMINI_API_KEY=your_gemini_api_key
